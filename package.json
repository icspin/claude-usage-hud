{
  "name": "claude-usage-hud",
  "productName": "Claude Usage HUD",
  "version": "0.1.10",
  "description": "Translucent always-on-top overlay showing live Claude Code token usage and cost per session, model, and day.",
  "main": "main.js",
  "author": "icspin",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.icspin.claudeusagehud",
    "productName": "Claude Usage HUD",
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "assets/**"
    ]
  }
}
